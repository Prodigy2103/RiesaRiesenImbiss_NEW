rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Menü-Kategorien und Gerichte: Öffentlich lesbar, Schreibschutz
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // Neuer Menü-Bestand: Öffentlich lesbar, Schreibschutz
    match /menuItems_New/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /ingredient-details/{detailId} {
      allow read: if true;
      allow write: if false;
    }

    // Kundenbestellungen: Anonyme Erstellung mit Status 'new' erlaubt
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'new';
      allow read, update, delete: if true;
    }

    // Archivierte Bestellungen: Abruf für Admin-Dashboard (beide Schreibweisen abgesichert)
    match /archivedOrders/{archiveId} {
      allow create, read: if true;
      allow update, delete: if false;
    }

    match /archived-orders/{archiveId} {
      allow create, read: if true;
      allow update, delete: if false;
    }
  }
}
